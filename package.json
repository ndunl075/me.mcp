    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@cloudflare/workers-types": "5.20261127.1",
    "typescript": "7.0.2",
    "vitest": "4.1.12",
    "wrangler": "4.168.0"
  }
}
