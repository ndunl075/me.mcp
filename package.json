{
  "name": "me.mcp",
  "version": "0.1.0",
  "description": "Turn yourself into an MCP server. Free, open source, zero-cost to host.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
